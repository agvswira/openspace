{
  "name": "openspace-backend",
  "version": "1.0.0",
  "description": "REST API Openspace (Node.js + Express + Prisma + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node scripts/dev.js --reset --no-server",
    "prisma:generate": "prisma generate",
    "db:studio": "node scripts/studio.js",
    "db:sync-permissions": "node scripts/sync-permissions.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^18.6.0-beta.19",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
