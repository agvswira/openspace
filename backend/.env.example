# Port REST API
API_PORT=4000
# Alamat frontend (untuk CORS dan tautan email)
CLIENT_URL=http://localhost:5180

# true  = jalankan PostgreSQL bawaan (embedded-postgres) otomatis, tanpa instalasi
# false = pakai PostgreSQL milik sendiri lewat DATABASE_URL
USE_EMBEDDED_DB=true
EMBEDDED_DB_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/openspace?schema=public

JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Kosongkan SMTP_HOST agar email hanya dicetak di terminal (mode pengembangan)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Openspace <no-reply@openspace.local>"
